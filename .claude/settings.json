{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-session-saved.sh",
            "timeout": 15,
            "statusMessage": "Checking the session log was saved"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-uncommitted.sh",
            "timeout": 15,
            "statusMessage": "Checking for uncommitted changes"
          }
        ]
      }
    ]
  }
}
